{
  "manifest_version": 3,
  "name": "YouTube Overlay",
  "description": "Custom overlay for YouTube Music",
  "version": "1.1",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "64": "icons/64.png",
      "128": "icons/128.png"
    }
  },
  "host_permissions": [
    "https://music.youtube.com/*",
    "http://localhost:3005/*"
  ]
}
